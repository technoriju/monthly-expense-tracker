# Copy to .env.local (git-ignored) for local builds. EAS builds read EAS environment variables.
# Never commit real IDs. See docs/ADMOB_SETUP.md.

# 1 = run the app-update gate in development builds (off by default in __DEV__).
EXPO_PUBLIC_UPDATE_GATE_IN_DEV=

# 0 = build without ads (banner never renders, consent never runs). Default: ads on (Android only).
EXPO_PUBLIC_ADS_ENABLED=

# Real banner ad unit ID (ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN). Empty = Google test unit.
# Used only in release builds; development builds always use the test unit.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=

# Real AdMob App IDs (ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN). Empty = Google sample App ID.
# Required for the EAS "production" profile (app.config.ts fails the build without it).
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
